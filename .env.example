# ---- Claude → サーバー ----
# MCP エンドポイントは /mcp/<MCP_PATH_SECRET> で公開される（32 文字以上。生成方法は README 参照）
MCP_PATH_SECRET=

# ---- Google OAuth（scripts/get_refresh_token.py で取得）----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---- 任意 ----
# create_watch で topic_name を省略したときの Pub/Sub トピック
# PUBSUB_TOPIC=projects/<project-id>/topics/<topic>
# 追加で許可する Host ヘッダ（カンマ区切り）。localhost と Render の RENDER_EXTERNAL_HOSTNAME は自動で許可される
# ALLOWED_HOSTS=forms-mcp.example.com
# 追加で許可する Origin ヘッダ（カンマ区切り）
# ALLOWED_ORIGINS=
# 待ち受け設定（Render では PORT が自動設定される）
# HOST=0.0.0.0
# PORT=8000
